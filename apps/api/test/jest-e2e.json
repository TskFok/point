{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "watchman": false,
  "maxWorkers": 1,
  "globalSetup": "<rootDir>/e2e-global-setup.ts",
  "globalTeardown": "<rootDir>/e2e-global-teardown.ts",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}

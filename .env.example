PORT=3000
DATABASE_URL=postgresql://point:point@localhost:5432/point
AUTH_JWT_SECRET=local-development-only-secret-change-me
WEB_ORIGIN=http://localhost:3001
# Next 服务端直连 Nest API；必须包含 /api/v1，Web 浏览器统一访问同源 /api/v1 rewrite。
API_SERVER_BASE_URL=http://localhost:3000/api/v1
TEST_DATABASE_URL=postgresql://point:point@localhost:5433/point_test
# 必须由 API 服务账户独占并保持 0700；禁止不可信同 UID 进程或共享卷写者写入。
PRODUCT_UPLOAD_ROOT=./uploads
# 商品图存储驱动：local（默认，写本地目录）或 r2（Cloudflare R2）
STORAGE_DRIVER=local
# STORAGE_DRIVER=r2 时必填（值从 Cloudflare 控制台读取，勿提交真实密钥）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 公开读 CDN 基址，无尾斜杠，例如 https://cdn.example.com
R2_PUBLIC_BASE_URL=
# Web：与 R2_PUBLIC_BASE_URL 对齐（运行时注入，Docker 无需为此重建镜像）
PRODUCT_IMAGE_PUBLIC_BASE_URL=
# 兼容旧名；本地 next dev 也可使用
NEXT_PUBLIC_PRODUCT_IMAGE_BASE_URL=
# 32 字节密钥的 base64；生产必须替换为随机值（下列为本地开发用全零占位）
AI_CONFIG_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# 是否将 AI chat/completions 完整 HTTP 响应体写入 AiTaskRun.aiResponseBody（默认关闭）
AI_TASK_STORE_RESPONSE_BODY=false

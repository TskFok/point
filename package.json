{
  "name": "point-quest",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "api:spec": "pnpm --filter @point-quest/api generate:openapi",
    "api:client": "pnpm --filter @point-quest/api-client generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:test:reset": "DATABASE_URL=postgresql://point:point@localhost:5433/point_test prisma migrate reset --force",
    "lint": "pnpm -r lint && pnpm lint:e2e",
    "lint:e2e": "apps/web/node_modules/.bin/eslint playwright.config.ts playwright scripts/*.mjs --config eslint.e2e.config.mjs",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p playwright/tsconfig.json",
    "test": "pnpm -r test && pnpm test:dev",
    "test:dev": "node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "pg": "8.22.0",
    "prisma": "7.9.1"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "playwright": "1.61.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
